rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        request.auth.token.role == role || 
        getUserData().role == role
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isStudent() {
      return hasRole('student');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isTeacher();
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'student';
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Student Profiles Collection
    match /studentProfiles/{profileId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() || 
        isTeacher()
      );
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if (resource.data.userId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'status', 'program', 'session'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Teacher Profiles Collection
    match /teacherProfiles/{profileId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Admission Applications Collection
    match /admissionApplications/{appId} {
      // Anyone can create an admission application
      allow create: if request.resource.data.status in ['Draft', 'Submitted', 'Under Review'];
      // Applicant can read their own by ref or auth, Admin can read all
      allow read: if true; // Public tracking by Ref Number supported via limited projection or auth
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Courses, Routines & Academic Structures
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /classRoutines/{routineId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    // Attendance Records
    match /attendance/{attId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTeacher() || 
        resource.data.studentId == getUserData().studentId
      );
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    // Examination Results
    match /results/{resultId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isTeacher() || 
        resource.data.studentId == getUserData().studentId
      );
      allow write: if isAdmin() || isTeacher();
    }

    // Notices Collection
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fee Structures & Obligations
    match /feeStructures/{feeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /feeObligations/{obligationId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.studentId == getUserData().studentId
      );
      allow write: if isAdmin(); // Only admin or trusted backend Cloud Function can update payment status
    }

    // Payment Transactions & Receipts
    // Critical: Clients cannot mark transactions as Paid directly
    match /paymentTransactions/{txnId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.studentId == getUserData().studentId
      );
      // Only trusted server/Cloud Function or Admin can write verified transactions
      allow create, update: if isAdmin();
      allow delete: if false; // Payment records are immutable
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Append only
      allow update, delete: if false; // Immutable audit trail
    }

  }
}
